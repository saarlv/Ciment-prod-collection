                },
                "date": {
                  "type": "string",
                  "description": "YYYY-MM-DD in the week, or null for claims with no date"
                },
                "kind": {
                  "type": "string",
                  "description": "פירעון / הבטחת תשלום / שולם לטענת הלקוח / בירור / הבטחה שהופרה"
                },
                "customerCode": {
                  "type": "string",
                  "description": ""
                },
                "customerName": {
                  "type": "string",
                  "description": ""
                },
                "bookkeeperName": {
                  "type": "string",
                  "description": ""
                },
                "invoiceNumbers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": ""
                },
                "amount": {
                  "type": "number",
                  "description": ""
                },
                "status": {
                  "type": "string",
                  "description": "Short Hebrew status, e.g. פתוחה, נראה תשלום, הופרה, לא נראה בבנק, יש הערה"
                },
                "noteText": {
