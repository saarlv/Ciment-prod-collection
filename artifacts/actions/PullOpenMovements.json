{
  "name": "PullOpenMovements",
  "type": "code",
  "description": "Morning pull, step 2 (plan 04.11, part A): pulls Priority's unmatched customer movements into OpenMovements and replaces the snapshot of every customer the source returns (rows of that customer not returned are deleted; nothing points at a movement). Each row gets the real customer link (Customers.id by customerCode), customerCode, customerName, docType, docNumber, docDate, dueDate, dueMonth (YYYY-MM of dueDate), amount (+ debt / − credit), details, source, importBatchId, syncedAt. Source: Priority ledger (FNCTRANS lines on the customer account with FRECONNUM 0), one GET per customer, sequential, cutoff AgentSettings openMovementsFromDate; only customers whose read completed are replaced (incomplete ones keep their rows); rows get source priority-direct; 12-minute budget with resume via PrioritySyncCursors. An empty source never empties the table (reported as failed). Run again after the receipts run (09:00 / 10:00). dryRun (default true) only reports. Never writes to Priority or contacts anyone.",
  "iconName": "list-tree",
  "inputSchema": {
    "type": "object",
    "properties": {
      "dryRun": {
        "type": "boolean",
        "default": true,
        "description": "Default true: only report what would be written"
      },
      "customerCodes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional: only these customers"
      },
      "importBatchId": {
        "type": "string",
        "description": "ImportBatches row of the run this pull belongs to (optional)"
      },
      "fullHistory": {
        "type": "boolean",
        "default": false,
        "description": "Drop the BALDATE cutoff (one-off runs); reports open lines older than the cutoff"
      },
      "resume": {
        "type": "boolean",
        "default": true,
        "description": "Continue an unfinished pass from the next customer (ignored with customerCodes)"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean"
      },
      "source": {
        "type": "string"
      },
      "customers": {
        "type": "number",
        "description": "Customers whose snapshot was replaced"
      },
      "fromSource": {
        "type": "number"
      },
      "written": {
        "type": "number"
      },
      "deleted": {
        "type": "number"
      },
      "unknownCustomers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Codes not in Customers (skipped)"
      },
      "customersRead": {
        "type": "number"
      },
      "customersIncomplete": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        },
        "description": "[{customerCode, error}] kept yesterday's rows"
      },
      "movements": {
        "type": "number"
      },
      "sumDebt": {
        "type": "number"
      },
      "sumCredit": {
        "type": "number"
      },
      "byDocType": {
        "type": "object",
        "additionalProperties": true,
        "description": "{docType: {count, sum}}"
      },
      "topCustomers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        },
        "description": "5 largest: {customerCode, customerName, openMovementsSum, invoicesOpenDebt, difference}"
      },
      "perCustomer": {
        "type": "object",
        "additionalProperties": true,
        "description": "Dry run: {code: {count, sum}}"
      },
      "samples": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "cutoff": {
        "type": "string"
      },
      "fullHistory": {
        "type": "boolean"
      },
      "olderThanCutoff": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      },
      "customersPlanned": {
        "type": [
          "number",
          "null"
        ]
      },
      "remaining": {
        "type": "number"
      },
      "needsResume": {
        "type": "boolean"
      },
      "resumed": {
        "type": "boolean"
      },
      "notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "created": {
        "type": "number"
      },
      "updated": {
        "type": "number"
      },
      "importBatchId": {
        "type": "string"
      },
      "syncedAt": {
        "type": "string"
      },
      "writeVerified": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      },
      "totalsByCustomer": {
        "type": "object",
        "additionalProperties": true,
        "description": "{customerCode: {dueMonth: total}}"
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "exposedToUI": false,
  "toolEffect": "mutation"
}