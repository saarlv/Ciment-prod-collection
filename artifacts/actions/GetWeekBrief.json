{
  "name": "GetWeekBrief",
  "type": "code",
  "description": "Read only. What the home screen (היום) shows. aging = the calendar week (Sunday to Saturday, Asia/Jerusalem) as seen by the aging report: open invoices that fall due this week (open amount net of payments the app already saw), commitments dated this week (CustomerNotes התחייבות לתשלום, with outcome פתוחה / קוימה / קוימה חלקית / לא קוימה), disputes (בירור notes) whose follow-up date falls this week, commitments not kept, and the biggest overdue customers with no note in the last 14 days; plus deterministic Hebrew conclusions (a headline and up to 6 short sentences) and KPIs. receipts = today's bank work day (same day rule as the receipts screen: the Israel date, Friday/Saturday count as Thursday): the files, how many credit transfers were pulled, how many are matched (approved or done in Priority), how many wait for a decision, how many are still to match, unidentified and bounced. bookkeeperName limits both parts to one bookkeeper's customers (CustomerOwners override, else Priority).",
  "iconName": "calendar-days",
  "inputSchema": {
    "type": "object",
    "properties": {
      "asOfDate": {
        "type": "string",
        "format": "date",
        "description": "Clock for the demo: YYYY-MM-DD. Defaults to today in Asia/Jerusalem"
      },
      "bookkeeperName": {
        "type": "string",
        "description": "Only this bookkeeper's customers; omit for everyone"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "asOfDate": {
        "type": "string",
        "description": "YYYY-MM-DD"
      },
      "dataAsOf": {
        "type": "string",
        "description": "Latest Invoices.syncedAt (ISO) or null"
      },
      "week": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "Sunday YYYY-MM-DD"
          },
          "end": {
            "type": "string",
            "description": "Saturday YYYY-MM-DD"
          },
          "label": {
            "type": "string",
            "description": "Hebrew label, e.g. 25.10–31.10"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "description": "YYYY-MM-DD"
                },
                "weekday": {
                  "type": "string",
                  "description": "א׳ … ש׳"
                },
                "isToday": {
                  "type": "boolean",
                  "description": ""
                },
                "isPast": {
                  "type": "boolean",
                  "description": ""
                },
                "itemCount": {
                  "type": "number",
                  "description": ""
                },
                "amount": {
                  "type": "number",
                  "description": "ILS of the day's items (due invoices + promises)"
                }
              }
            },
            "description": "Sunday..Saturday"
          }
        }
      },
      "aging": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string",
            "description": "One Hebrew sentence, the bottom line for the week (built by code)"
          },
          "conclusions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 6 short Hebrew sentences, most important first"
          },
          "kpis": {
            "type": "object",
            "properties": {
              "dueThisWeekAmount": {
                "type": "number",
                "description": ""
              },
              "dueThisWeekCount": {
                "type": "number",
                "description": "Invoices"
              },
              "dueThisWeekCustomers": {
                "type": "number",
                "description": ""
              },
              "promisedThisWeekAmount": {
                "type": "number",
                "description": ""
              },
              "promisedThisWeekCount": {
                "type": "number",
                "description": ""
              },
              "promisesSeenAmount": {
                "type": "number",
                "description": "Of this week's promises, ILS already seen in the bank"
              },
              "brokenPromisesCount": {
                "type": "number",
                "description": ""
              },
              "claimedPaidOpenAmount": {
                "type": "number",
                "description": ""
              },
              "claimedPaidOpenCount": {
                "type": "number",
                "description": "Invoices"
              },
              "disputesFollowUpCount": {
                "type": "number",
                "description": ""
              },
              "overdueTotal": {
                "type": "number",
